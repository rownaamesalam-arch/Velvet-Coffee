{
  "compilerOptions": {

    "target": "ES2022",

    "module": "NodeNext",

    "moduleResolution": "NodeNext",

    "rootDir": "./src",

    "outDir": "./dist",

    "types": ["node"],

    "sourceMap": false,

    "declaration": false,

    "declarationMap": false,

    "strict": true,

    "esModuleInterop": true,

    "forceConsistentCasingInFileNames": true,

    "skipLibCheck": true,

    "noUncheckedIndexedAccess": true,

    "exactOptionalPropertyTypes": true

  },

  "include": [
    "src"
  ]

}
